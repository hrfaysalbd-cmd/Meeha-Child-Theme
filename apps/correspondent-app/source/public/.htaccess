# SPA fallback for Apache (Hostinger shared hosting) — correspondent.meeha.news
# serves a React Router app; any path that isn't a real file/folder must
# fall back to index.html so client-side routing (e.g. /app/write/123,
# /apply, /login) works on a hard refresh or a direct link, not just via
# in-app navigation.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Service worker, index.html and the version files must never be cached,
# or updates won't reach users (r31: index.html + version.json added).
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|push-sw\.js|index\.html|version\.json|manifest\.webmanifest|android\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# r31: the Android app file downloads as an app, not as a zip
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>
